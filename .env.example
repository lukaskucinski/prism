# Supabase (PRISM project ref: uuqxqqcelabpacljeqgm)
NEXT_PUBLIC_SUPABASE_URL=https://uuqxqqcelabpacljeqgm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for the Python pipeline.
# Get from Supabase dashboard → Project Settings → Database → Connection string.
# IMPORTANT: percent-encode any special chars in the password (e.g. !→%21, /→%2F, #→%23, @→%40).
# Run `node scripts/check-db-url.mjs` after editing to validate without echoing the password.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.uuqxqqcelabpacljeqgm.supabase.co:5432/postgres

# Mapbox public token (NEXT_PUBLIC_ for client-side use)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Tile version — bump after rescore / weight changes to invalidate CDN cache
NEXT_PUBLIC_TILE_VERSION=1

# Sentry (optional for local dev)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Pilot scope — VT only is what gets pushed to Supabase (~50k hexes, fits free
# tier). Use the ingest CLI's `--local-output <path>` flag with `--states NV`
# (or any other state) for local-only analytical exports to GeoPackage.
PRISM_PILOT_STATES=VT
