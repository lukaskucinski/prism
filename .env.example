# Supabase (PRISM project, separate from HexRoute)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for the Python pipeline
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Mapbox public token (NEXT_PUBLIC_ for client-side use)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Tile version — bump after rescore / weight changes to invalidate CDN cache
NEXT_PUBLIC_TILE_VERSION=1

# Sentry (optional for local dev)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Pilot scope
PRISM_PILOT_STATES=VT,NV
